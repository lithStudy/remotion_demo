    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "description": "因果节点；showFrom 为 content 数组下标（0-based），入场时刻取该条 startFrame",
      "items": {
        "type": "object",
        "required": [
