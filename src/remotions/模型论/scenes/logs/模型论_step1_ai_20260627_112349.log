            "description": "该节拍配图提示词"
          },
          "enterEffect": {
            "type": "string",
            "enum": [
              "breathe",
              "slideLeft",
              "slideBottom",
              "zoomIn",
              "fadeIn"
            ],
            "default": "breathe",
            "description": "入场效果"
          },
