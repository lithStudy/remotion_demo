            "type": "string",
            "description": "要高亮的子串，须出现在各 coreSentence 段拼接后的全文内"
          },
          "color": {
            "type": "string",
            "description": "高亮颜色，省略时默认强调色"
          }
        }
      }
    }
  },
  "required": [
    "coreSentence"
  ]
}

