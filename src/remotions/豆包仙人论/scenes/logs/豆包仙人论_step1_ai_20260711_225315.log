        "type": "object",
        "required": [
          "coreSentenceAnchor"
        ],
        "properties": {
          "coreSentenceAnchor": {
            "type": "string",
            "description": "要高亮的子串，须出现在各 coreSentence 段拼接后的全文内"
          },
          "color": {
            "type": "string",
            "description": "高亮颜色，省略时默认强调色"
          }
        }
      }
    }
  },
  "required": [
    "coreSentence"
  ]
}

// 口播条数（已由程序写入 CONTENT_STR，勿在 param 中输出 content）：口播分句至多 3 条（超出会被校验器告警）


