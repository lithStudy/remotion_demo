            "type": "string",
            "description": "节点短标签，建议 2～8 字"
          },
          "imageSrc": {
            "type": "string",
            "format": "image_prompt",
            "description": "该环节隐喻配图"
          },
          "showFrom": {
            "type": "integer",
            "format": "content_index",
            "description": "content 下标（0-based），非帧数"
          },
          "enterEffect": {
            "type": "string",
            "enum": [
              "breathe",
              "slideLeft",
              "slideBottom",
              "zoomIn",
              "fadeIn"
            ],
            "default": "fadeIn"
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "description": "可选；顶部依次展示锚点词并保留为列表，showFrom 为 content 下标（0-based，非帧数）；保持克制，只提取整段里真正的高潮、反转或核心名词",
      "items": {
        "type": "object",
        "required": [
