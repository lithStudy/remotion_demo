{
  "name": "scene_studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "export:param-override-requirements": "python scripts/run_pipeline_mod.py narrator_pipeline.codegen.export_param_override_requirements",
    "check:param-overrides": "python scripts/run_pipeline_mod.py narrator_pipeline.codegen.check_param_overrides",
    "generate:param-overrides": "npm run export:param-override-requirements && python scripts/run_pipeline_mod.py narrator_pipeline.codegen.generate_param_overrides",
    "build": "npm run check:param-overrides && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
