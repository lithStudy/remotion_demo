# Google Gemini API Key (用于文案分析和图片生成)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API Key（用于 Step1 文案分析，可选）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# MiMo API Key（用于 Step1 文案分析，可选）
MIMO_API_KEY=your_mimo_api_key_here

# Azure Speech Service Key (用于TTS语音合成)
SPEECH_KEY=your_azure_speech_key_here

# Scene Studio Web（Step0/1 工作台）
SCENE_STUDIO_PASSWORD=111111
SCENE_STUDIO_WORKSPACE=d:/data/scene_studio_workspace
