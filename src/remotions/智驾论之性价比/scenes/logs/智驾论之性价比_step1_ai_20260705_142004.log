      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "description": "宫格配图；showFrom 为 content 下标（0-based），在该条 startFrame 显现",
      "items": {
        "type": "object",
        "required": [
          "src",
          "showFrom"
        ],
        "properties": {
          "src": {
            "type": "string",
            "format": "image_prompt",
            "description": "该宫格配图提示词"
          },
          "showFrom": {
            "type": "integer",
            "format": "content_index",
            "description": "content 下标（0-based），非帧数"
          },
          "position": {
            "type": "string",
            "enum": [
              "center",
              "left",
              "right",
              "top",
              "bottom"
            ],
            "description": "可选；弱提示，布局以宫格为准"
          },
          "enterEffect": {
            "type": "string",
            "enum": [
              "breathe",
              "slideLeft",
              "slideBottom",
              "zoomIn",
              "fadeIn"
            ],
            "default": "fadeIn"
          }
        }
      }
    }
  },
  "required": [
    "panels"
  ]
}

